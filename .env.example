# Supabase Public Configuration (Browser-Safe Client Keys)
# NOTE: Row Level Security (RLS) policies on Supabase handle all access control.
# DO NOT place service_role key or database master passwords in client-side code or .env files.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
